{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "check",
      "type": "npm",
      "script": "check",
      "problemMatcher": ["$tsc", "$eslint-stylish"],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "typecheck: watch",
      "type": "npm",
      "script": "typecheck:watch",
      "problemMatcher": ["$tsc-watch"],
      "isBackground": true,
      "presentation": { "reveal": "never" }
    }
  ]
}
